  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 343e84e715cff2148a80fbc5357c393e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreditsRoll
  lines:
  - 'Echoes of Myself


    Realizado por:

'
  - 'Dhana Samantha Aragon: Art & Visual Design'
  - "\u2022\tPlanificaci\xF3n historia del juego.\n\u2022\tCreaci\xF3n de todos los
    sprites del juego.\n\u2022\tColaboraci\xF3n en el dise\xF1o de niveles y las
    mec\xE1nicas de juego.\n\u2022\tImplementaci\xF3n la escena final.\n"
  - "Nic\xF3las Ruiz Project Management & Gameplay Programming"
  - "\u2022\tPlanificaci\xF3n historia del juego.\n\u2022\tCoordinaci\xF3n del equipo
    y del desarrollo del proyecto.\n\u2022\tProgramaci\xF3n de las mec\xE1nicas principales
    del juego.\n\u2022\tIntegraci\xF3n de los recursos visuales e interfaz creados
    por el equipo.\n\u2022\tImplementaci\xF3n y programaci\xF3n del sistema de subt\xEDtulos.\n"
  - "John Alejandro Vera: Narrative Design & Audio creados por el equipo.\n\u2022\tImplementaci\xF3n
    y programaci\xF3n del sistema de subt\xEDtulos."
  - "\u2022\tPlanificaci\xF3n historia del juego.\n\u2022\tRedacci\xF3n del Documento
    de Dise\xF1o del Juego (GDD).\n\u2022\tSelecci\xF3n de los efectos de sonido
    y recursos de audio del juego.\n"
  - 'Stephania Gonzalez: UI Design & Programming'
  - "\u2022\tPlanificaci\xF3n historia del juego.\n\u2022\tDise\xF1o de la interfaz
    de usuario del juego.\n\u2022\tProgramaci\xF3n de los elementos e interacciones
    de la interfaz.\n"
  - Agradecimiento especial a Generation Colombia
  font: {fileID: 11400000, guid: fe2adb1d236d1164caca724193808684, type: 2}
  fontSize: 45.2
  textColor: {r: 1, g: 1, b: 1, a: 1}
  textWidth: 1400
